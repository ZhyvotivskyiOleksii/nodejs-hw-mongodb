{
  "name": "nodejs-hw-mongodb",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build-docs",
    "build-docs": "npx redocly bundle docs/openapi.yaml --ext json -o docs/swagger.json",
    "preview-docs": "npx redocly preview-docs",
    "dev": "npm run build-docs && nodemon src/index.js",
    "postinstall": "npm run build-docs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
